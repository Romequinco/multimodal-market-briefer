# ─────────────────────────────────────────────────────────────────────────────
# Configuración de Briefly (código interno: briefer). Copia este fichero a .env y rellena lo que uses.
# .env NUNCA se versiona. Sin claves, todo funciona en modo mock (datos simulados).
# ─────────────────────────────────────────────────────────────────────────────

# ── Claves de API ────────────────────────────────────────────────────────────
# Anthropic (LLM de los agentes y visión). https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI (Whisper API para voz a texto; LLM alternativo).
OPENAI_API_KEY=
# Google Gemini (LLM alternativo, TTS multi-locutor de pago con BRIEFER_TTS_PROVIDER=gemini y portada
# con BRIEFER_IMAGE_GEN_PROVIDER=gemini). Ojo: los modelos de imagen no tienen nivel gratuito; sin
# facturación activa en el proyecto de la clave responden 429 (cuota 0) y el briefing sale sin portada.
GEMINI_API_KEY=
# ElevenLabs (TTS alternativo, de pago).
ELEVENLABS_API_KEY=

# ── Entrega: Telegram ────────────────────────────────────────────────────────
# Token del bot (créalo con @BotFather → /newbot) y chat de destino. Tras poner el token, escribe al
# bot y ejecuta `python scripts/telegram_setup.py --write` (rellena TELEGRAM_CHAT_ID) y luego `--test`.
# En la UI, «Enviar por → Telegram» solo aparece si las dos variables están rellenas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Proveedores (intercambiables) ────────────────────────────────────────────
# LLM: anthropic | gemini | openai | mock
BRIEFER_LLM_PROVIDER=anthropic
# Visión: claude | qwen_local | mock
BRIEFER_VISION_PROVIDER=claude
# Voz a texto: whisper_api | whisper_local | mock
BRIEFER_STT_PROVIDER=whisper_api
# Texto a voz: edge | gemini | elevenlabs | mock   (edge es gratis y no necesita clave; gemini es
# de pago, más natural, para la demo; si falla, el podcast cae a edge y el Q&A siempre usa edge)
BRIEFER_TTS_PROVIDER=edge
# Texto a imagen para la portada: local | gemini | none | mock   (local es gratis: modelo abierto de
# Hugging Face en CPU, necesita requirements-local.txt y descarga ~1,8 GB la primera vez; gemini es
# de pago, ≈ 0,03 € por portada, y necesita GEMINI_API_KEY; none = sin portada; sdxl_turbo = alias de local)
BRIEFER_IMAGE_GEN_PROVIDER=none
# Clasificador zero-shot de capturas: clip | none | mock   (clip es local y gratis, necesita
# requirements-local.txt y descarga ~600 MB la primera vez; enruta cada imagen subida: gráfico/tabla
# → visión con pista, no financiera → rechazada sin llamar a visión, captura de cartera → «Mi cartera»)
BRIEFER_IMAGE_CLASSIFIER_PROVIDER=none
# Si falta una clave o librería, usar mock (con aviso) en lugar de fallar.
BRIEFER_FALLBACK_TO_MOCK=true

# ── Modelos ──────────────────────────────────────────────────────────────────
BRIEFER_LLM_MODEL=claude-sonnet-5-5
# Modelo barato para tareas sencillas (Q&A, resúmenes de documentos).
BRIEFER_LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
# Modelo del Guionista. Vacío = el barato (BRIEFER_LLM_MODEL_CHEAP, Haiku 4.5): medido el 05-oct-2026,
# cumple las puertas de calidad a ≈0,009 € por guion. Ej. para probar Sonnet: claude-sonnet-5-5 (≈0,025 €).
BRIEFER_SCRIPTWRITER_MODEL=
BRIEFER_GEMINI_MODEL=gemini-2.5-flash
BRIEFER_OPENAI_MODEL=gpt-4o-mini
BRIEFER_VISION_MODEL=claude-sonnet-5-5
# Modelos locales (requieren requirements-local.txt).
BRIEFER_QWEN_VL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# Voz a texto (OpenAI): gpt-4o-mini-transcribe (por defecto: más rápido y la mitad de caro, medido
# el 05-oct-2026) | whisper-1. Límite de la API: 25 MB por audio.
BRIEFER_WHISPER_API_MODEL=gpt-4o-mini-transcribe
# tiny | base | small | medium (más grande = más preciso y más lento)
BRIEFER_WHISPER_LOCAL_MODEL=base
# Portada local (solo si BRIEFER_IMAGE_GEN_PROVIDER=local): IDKiro/sdxs-512-dreamshaper (OpenRAIL++, uso
# comercial, 1 paso, ~1,8 GB, ~4-7 s por portada en CPU) | SimianLuo/LCM_Dreamshaper_v7 (MIT, 4 pasos, ~4,3 GB)
# | stabilityai/sd-turbo (Stability AI Community License: comercial solo con registro y < 1 M$).
BRIEFER_SDXL_MODEL=IDKiro/sdxs-512-dreamshaper
# Pasos de inferencia (0 = los recomendados para el modelo: 1 en SDXS, 4 en LCM, 2 en turbo).
BRIEFER_SDXL_STEPS=0
# Portada con Gemini (solo si BRIEFER_IMAGE_GEN_PROVIDER=gemini): el más barato, 0,0336 $ por imagen 1K
# (gemini-3.1-flash-image da más calidad a 0,067 $).
BRIEFER_GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# CLIP del router de imágenes (solo si BRIEFER_IMAGE_CLASSIFIER_PROVIDER=clip; CPU).
BRIEFER_CLIP_MODEL=openai/clip-vit-base-patch32
# auto | cpu | cuda | mps
BRIEFER_LOCAL_DEVICE=auto

# ── Idioma y voces ───────────────────────────────────────────────────────────
BRIEFER_LANGUAGE=es
# Voces de edge-tts (lista completa: edge-tts --list-voices | findstr es-ES)
BRIEFER_VOICE_A=es-ES-AlvaroNeural
BRIEFER_VOICE_B=es-ES-XimenaNeural
# Velocidad y tono de edge-tts (vacío = "+10%" / "+0Hz"). Ej.: +8% / -2Hz
BRIEFER_TTS_RATE=+10%
BRIEFER_TTS_PITCH=
# Nombres de los locutores en el guion, la transcripción y el SRT (marca Briefly): A = Toro
# (voz A, masculina; el optimista que abre) y B = Osa (voz B, femenina; la prudente que cierra
# con el aviso legal). Si cambias las voces, mantén A masculina y B femenina o cambia los nombres.
BRIEFER_SPEAKER_A_NAME=Toro
BRIEFER_SPEAKER_B_NAME=Osa
# Gemini TTS (solo si BRIEFER_TTS_PROVIDER=gemini): modelo y voces precompuestas (A = Toro, B = Osa).
BRIEFER_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
BRIEFER_GEMINI_VOICE_A=Puck
BRIEFER_GEMINI_VOICE_B=Kore
# Ids de voz de ElevenLabs (solo si BRIEFER_TTS_PROVIDER=elevenlabs).
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Contenido del briefing ───────────────────────────────────────────────────
# Tickers por defecto (formato Yahoo Finance), separados por comas.
BRIEFER_DEFAULT_TICKERS=SAN.MC,ITX.MC,IBE.MC,AAPL,NVDA
# Índices de referencia que acompañan a todo briefing (precios + noticias de mercado). No cuentan
# como tickers del usuario; aparecen en el gráfico de variación del día. Vacío = sin índices.
BRIEFER_CONTEXT_TICKERS=^IBEX,^GSPC
# Feeds RSS generalistas de mercados, separados por comas. Vacío = los feeds verificados de
# ingest/news.py (DEFAULT_MARKET_FEEDS: Expansión «Mercados» y Europa Press). Además, por
# cada ticker se consultan siempre Google News (es-ES), el RSS de Yahoo Finance y yfinance.
# Ej.: https://e00-expansion.uecdn.es/rss/mercados.xml,https://www.europapress.es/rss/rss.aspx?ch=00136
BRIEFER_NEWS_RSS_FEEDS=
BRIEFER_NEWS_MAX_ITEMS=20
# «Impacto de la noticia» con FinBERT, en paralelo con el Analista (necesita: pip install -r requirements-local.txt).
BRIEFER_FINBERT=false
# Duración objetivo del podcast en minutos.
BRIEFER_PODCAST_TARGET_MINUTES=4
# Verificar el podcast con el STT (solo modo real y STT real): se transcribe el MP3 final y se
# mide el WER frente al guion (paso opcional «media.verify», en paralelo con los gráficos).
# Coste ≈ 0,015 € por episodio de 5 min con gpt-4o-mini-transcribe (0,03 € con whisper-1).
BRIEFER_VERIFY_PODCAST=true
# Tema de los gráficos PNG: dark (por defecto, a juego con la UI) | light (impresión).
BRIEFER_CHART_THEME=dark

# ── Rutas (relativas a la raíz del repo) ─────────────────────────────────────
BRIEFER_DATA_DIR=data
BRIEFER_CACHE_DIR=data/cache
BRIEFER_OUTPUT_DIR=data/outputs
BRIEFER_SAMPLES_DIR=data/samples

# DEBUG | INFO | WARNING | ERROR
BRIEFER_LOG_LEVEL=INFO
